# Copie para .env. Nunca versione credenciais reais.
ENVIRONMENT=development
# Senha do PostgreSQL local; use apenas letras e números para evitar escape na URL.
POSTGRES_PASSWORD=localOnlyChangeBeforeDeploy2026
NEXO_API_PASSWORD=nexo_api_local_dev_only
NEXO_MIGRATOR_PASSWORD=nexo_migrator_local_dev_only
NEXO_EXECUTOR_PASSWORD=nexo_executor_local_dev_only
# Configure true apenas para o seed local. A aplicação rejeita isso em staging/production.
DEV_AUTH=true
DEV_TOKEN=local-demo-change-this-token-2026
# Para execução fora do Docker (Compose substitui os hosts por db/redis).
DATABASE_URL=postgresql+psycopg://nexo_api:nexo_api_local_dev_only@localhost:5432/nexo
DATABASE_API_URL=postgresql+psycopg://nexo_api:nexo_api_local_dev_only@localhost:5432/nexo
DATABASE_EXECUTOR_URL=postgresql+psycopg://nexo_executor:nexo_executor_local_dev_only@localhost:5432/nexo
REDIS_URL=redis://localhost:6379/0
# Projeto Supabase com assinatura assimétrica ES256/RS256; sem service role no browser.
SUPABASE_URL=
SUPABASE_AUDIENCE=authenticated
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEV_AUTH=true
# JSON com origens permitidas; configure domínio HTTPS em produção.
CORS_ORIGINS=["http://localhost:3000"]
